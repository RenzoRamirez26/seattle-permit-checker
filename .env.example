# Copy this file to .env and fill in what you need. .env is ignored by git.
# Nothing here is needed for the demo plans, the tests, or the Seattle data download.

# Claude API key: needed to read an uploaded plan and for the agent's model answers.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Free app token from https://data.seattle.gov (Sign in > Developer Settings).
# Only raises the rate limit on the data download.
SEATTLE_APP_TOKEN=

# Optional model overrides.
# PERMIT_VISION_MODEL=claude-sonnet-5-5
# PERMIT_AGENT_MODEL=claude-sonnet-5-5

# Optional voice settings (see requirements-voice.txt).
# PERMIT_STT=faster-whisper     # or: off
# PERMIT_STT_MODEL=base.en      # tiny.en is faster, small.en more accurate
# PERMIT_STT_PROMPT=on          # or: off (do not give Whisper the list of code words)
# PERMIT_TTS=browser            # or: kokoro
# PERMIT_TTS_VOICE=af_heart     # any Kokoro voice, for example am_michael
# PERMIT_TTS_MODEL=kokoro-v1.0.onnx   # or kokoro-v1.0.int8.onnx: smaller download (92 MB, not 325 MB)
