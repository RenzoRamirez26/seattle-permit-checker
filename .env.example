# Every setting the code reads, with no values. Copy this file to .env for your computer; .env is ignored by git.
# On a host, type them into its settings instead (docs/launch.md). tests/test_api_security.py fails if the code reads a
# variable this file does not list. Nothing here is needed for the demo plans, the tests, or the Seattle data download.

# ---------------------------------------------------------------- the API server (api/, checker/, pipeline/)
# Secret. Plan reading and the assistant's model answers. From https://console.anthropic.com. Server only, never the site.
ANTHROPIC_API_KEY=
# Optional, free from https://data.seattle.gov. Only raises the rate limit on the Seattle data download.
SEATTLE_APP_TOKEN=

# production: no /docs, only PERMIT_CORS_ORIGIN may call, HSTS sent. The Dockerfile sets it. Default: development.
PERMIT_ENV=
# 1 to keep /docs, /redoc and /openapi.json on in production. Default: off in production.
PERMIT_API_DOCS=
# The site's origin, e.g. https://permitos.example (several, comma-separated). In development localhost:3000 is added.
PERMIT_CORS_ORIGIN=
# How many proxies of the host sit in front of the API (1 on Render, Railway and Fly). Default: 0.
PERMIT_PROXY_HOPS=
# Model calls (plan readings and assistant answers) the whole site may make per UTC day. Default: 10 (sized for $10 a month: docs/launch.md, Budget).
PERMIT_DAILY_MODEL_CALLS=
# Secret. Cloudflare Turnstile's secret key. Set with NEXT_PUBLIC_TURNSTILE_SITE_KEY to require it. Default: off.
PERMIT_TURNSTILE_SECRET=

# Per-address rate limits, "requests/seconds". Defaults: 10/600, 30/600, 30/600, 30/600, 30/600, 60/600.
PERMIT_RATE_PLAN_READ=
PERMIT_RATE_ASK=
PERMIT_RATE_TRANSCRIBE=
PERMIT_RATE_ZONING=
PERMIT_RATE_CHECKS=
PERMIT_RATE_PDF=

# Days a stored check is kept. Default: 30.
PERMIT_CHECK_DAYS=
# Largest plan file in MB. Default: 10.
PERMIT_MAX_UPLOAD_MB=
# Most pages in a PDF plan. Default: 10.
PERMIT_MAX_PDF_PAGES=
# Largest picture in megapixels (width x height). Default: 40.
PERMIT_MAX_IMAGE_MEGAPIXELS=
# Largest spoken question in MB. Default: 2.
PERMIT_MAX_AUDIO_MB=
# Where checks and the daily model-call count are stored. Default: data/checks.sqlite (the image: /data/checks.sqlite).
PERMIT_CHECKS_DB=
# Seattle's review records, built by python -m pipeline.run_pipeline --seattle. Default: data/permits.sqlite.
PERMIT_SEATTLE_DB=

# Model names. Default: claude-sonnet-5-5. Re-run python -m evaluation.evaluate_extraction --vision before changing.
PERMIT_VISION_MODEL=
PERMIT_AGENT_MODEL=

# Voice (requirements-voice.txt). PERMIT_STT: faster-whisper (default) or off. PERMIT_STT_MODEL: base.en (default),
# tiny.en or small.en. PERMIT_STT_PROMPT: on (default) or off. PERMIT_TTS: browser (default) or kokoro.
PERMIT_STT=
PERMIT_STT_MODEL=
PERMIT_STT_PROMPT=
PERMIT_TTS=
# Kokoro only: a voice such as af_heart, the model file, and where its files are downloaded (default data/models).
PERMIT_TTS_VOICE=
PERMIT_TTS_MODEL=
PERMIT_MODEL_DIR=
# 1 to ignore a .env file (the tests and the Docker image do).
PYTHON_DOTENV_DISABLED=

# ---------------------------------------------------------------- the website build (web/), set on the static host
# These are built into the public site, so none of them is a secret.
# The API's address, e.g. https://api.permitos.example. Default: http://localhost:8000.
NEXT_PUBLIC_API_BASE=
# The site's own address, for canonical URLs, the sitemap and the social image, e.g. https://permitos.example.
NEXT_PUBLIC_SITE_URL=
# The address on the Privacy and Terms pages. Until set, they show "[contact email]".
NEXT_PUBLIC_CONTACT_EMAIL=
# Cookieless analytics: the site's domain as registered in Plausible. Empty: no analytics script at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: Plausible's script, for a self-hosted Plausible. Default: https://plausible.io/js/script.manual.js.
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Cloudflare Turnstile's site key (public). Set with PERMIT_TURNSTILE_SECRET on the API. Empty: no Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
