    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
