    "postbuild": "node scripts/csp.mjs && node scripts/guard.mjs out",
    "guard": "node scripts/guard.mjs src",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "openapi": "sh scripts/openapi.sh",
    "pretest": "node scripts/copy-demo.mjs",
    "test": "vitest run",
    "pree2e": "node scripts/copy-demo.mjs",
    "e2e": "playwright test",
    "screenshots": "SHOTS=1 playwright test",
    "images": "node scripts/make-images.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "@hookform/resolvers": "7.0.8",
    "lucide-react": "1.78.0",
    "maplibre-gl": "6.19.0",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "pdfjs-dist": "6.5.438",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
