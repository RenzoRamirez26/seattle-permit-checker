{
  "name": "seattle-permit-precheck-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "predev": "node scripts/copy-demo.mjs",
    "dev": "next dev",
